// --- ROTAS API ---
app.get('/', (req, res) => res.send(html));

// Webhook para Automação de Depósito (Asaas)
app.post("/webhook", async (req, res) => {
  if (req.body.event === "PAYMENT_RECEIVED") {
    const p = req.body.payment;
    const user = db.prepare("SELECT * FROM users WHERE asaas_id = ?").get(p.customer);
    processarDivisao(p.value, user.id, user.pai_id);
  }
  res.sendStatus(200);
});

// Forçar Master ID 1
db.prepare("UPDATE users SET role='master' WHERE id=1").run();

app.listen(process.env.PORT || 3000, () => console.log("ICE Rodando!"));
