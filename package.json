require("dotenv").config();
const express = require("express");
const jwt = require("jsonwebtoken");
const Database = require("better-sqlite3");
const axios = require("axios");
const app = express();
const db = new Database("ice.db");

// Configurações de Segurança (Variáveis Ocultas)
const JWT_SECRET = process.env.JWT_SECRET || "mudar_isso_no_render";
const ASAAS_KEY = process.env.ASAAS_KEY;
const ASAAS_URL = "https://api.asaas.com"; // Mude para sandbox se for teste

app.use(express.json());

// --- BANCO DE DADOS ---
db.exec(`
  CREATE TABLE IF NOT EXISTS users (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    username TEXT UNIQUE,
    role TEXT DEFAULT 'filho', -- master, super, filho
    blues REAL DEFAULT 0,
    pai_id INTEGER,
    asaas_id TEXT,
    is_blocked INTEGER DEFAULT 0
  );
  CREATE TABLE IF NOT EXISTS lives (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    title TEXT,
    price REAL,
    is_adult INTEGER DEFAULT 0,
    creator_id INTEGER,
    active INTEGER DEFAULT 1
  );
`);

// --- LOGICA DE PORCENTAGEM E DIVISÃO (85% / 10% / 5%) ---
const processarDivisao = (valorTotal, usuarioId, paiId) => {
  const valorFilho = valorTotal * 0.85;
  const valorApp = valorTotal * 0.10;
  const valorPai = valorTotal * 0.05;

  db.prepare("UPDATE users SET blues = blues + ? WHERE id = ?").run(valorFilho, usuarioId);
  if (paiId) {
    db.prepare("UPDATE users SET blues = blues + ? WHERE id = ?").run(valorPai, paiId);
  }
  // Os 10% do App ficam acumulados no saldo do Master (ID 1)
  db.prepare("UPDATE users SET blues = blues + ? WHERE id = 1").run(valorApp);
};

